# =============================================================================
# ValorReal — variáveis de ambiente do front-end Next.js
# Copie este arquivo para .env.local e preencha os valores
# =============================================================================

# Supabase — projeto: transparencia-federal (redggdtakzmsabwvjzhb)
# Onde encontrar: dashboard.supabase.com → projeto → Settings → API
#
#   NEXT_PUBLIC_SUPABASE_URL  → "Project URL" (começa com https://...)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY → "anon public" (em Project API keys)
#   SUPABASE_SERVICE_ROLE_KEY → "service_role secret" (em Project API keys)
#
NEXT_PUBLIC_SUPABASE_URL=https://redggdtakzmsabwvjzhb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Maptiler — não necessário (mapa usa OpenFreeMap, gratuito sem key)
NEXT_PUBLIC_MAPTILER_KEY=
